<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.finkavo.social.renderer-agent</string>
  <key>ProgramArguments</key><array><string>__HOME__/.config/finkavo-social/run-renderer-agent.sh</string></array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>WorkingDirectory</key><string>__PROJECT_DIR__</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/FinkavoSocial/renderer-agent.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/FinkavoSocial/renderer-agent.err.log</string>
  <key>ProcessType</key><string>Background</string><key>ThrottleInterval</key><integer>10</integer>
</dict></plist>
