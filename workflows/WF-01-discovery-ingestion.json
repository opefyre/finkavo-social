{
  "id": "jjVdkDArzPpLJ3yf",
  "name": "WF-01 Portugal News Discovery (RSS, free)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
                "field": "cronExpression",
                "expression": "15 */3 * * *"
            }
          ]
        }
      },
      "id": "b778214b-9812-4689-a84c-8f0c1f02d2d6",
      "name": "Every 2 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -520,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://news.google.com/rss/search?q=Portugal%20tax%20immigration%20housing%20government&hl=en&gl=PT&ceid=PT:en"
      },
      "id": "205ead30-6dce-45df-9e83-4ae3d0a65740",
      "name": "Fetch free discovery feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000,
      "position": [
        -280,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items=$input.all().map(({json:a})=>({url:a.link,title:a.title,publisher:a.creator||a.author||null,locale:'en',publishedAt:a.isoDate||a.pubDate||null,category:'general',riskLevel:'medium'})).filter(a=>a.url&&a.title).slice(0,100); return items.length?[{json:{items,sourceKind:'news_discovery'}}]:[];"
      },
      "id": "19cf5f54-ddd5-4618-b4e4-a95a65f2dfef",
      "name": "Normalize discovery only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4320/v1/discoveries",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "52cde1e5-c778-48e1-bfa1-89a1c493235f",
      "name": "Store deduplicated discoveries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        0
      ],
      "credentials": {"httpBearerAuth":{"id":"socialApiBearer01","name":"Finkavo Social API"}}
    }
  ],
  "connections": {
    "Every 2 hours": {
      "main": [
        [
          {
            "node": "Fetch free discovery feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch free discovery feed": {
      "main": [
        [
          {
            "node": "Normalize discovery only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize discovery only": {
      "main": [
        [
          {
            "node": "Store deduplicated discoveries",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Lisbon"
  },
  "active": false,
  "tags": []
}
