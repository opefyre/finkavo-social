{
  "name": "WF-01 Canonical Official Source Monitoring",
  "nodes": [
    {
      "parameters": {"rule":{"interval":[{"field":"cronExpression","expression":"45 */3 * * *"}]}},
      "id": "official-schedule", "name": "Every 3 hours", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-700,0]
    },
    {
      "parameters": {"jsCode":"const urls=['https://info.portaldasfinancas.gov.pt/pt/apoio_contribuinte/calendario_fiscal/Pages/default.aspx','https://info.portaldasfinancas.gov.pt/pt/apoio_ao_contribuinte/Cidadaos/Rendimentos/Declaracao/prazos/Paginas/default.aspx','https://info.portaldasfinancas.gov.pt/pt/apoio_ao_contribuinte/Cidadaos/Casa_e_propriedades/Imposto_anual/Paginas/default.aspx','https://www.seg-social.pt/trabalhadores-independentes','https://bpstat.bportugal.pt/conteudos/noticias','https://www.dgeste.mec.pt/?page_id=53180'];return urls.map(url=>({json:{url}}));"},
      "id": "official-urls", "name": "Canonical URLs", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-480,0]
    },
    {
      "parameters": {"url":"={{ $json.url }}","options":{"timeout":120000,"response":{"response":{"fullResponse":true,"neverError":true,"responseFormat":"text"}}}},
      "id": "official-fetch", "name": "Fetch canonical page", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 30000, "position": [-240,0]
    },
    {
      "parameters": {"jsCode":"const inputs=$input.all();const urls=$('Canonical URLs').all();return inputs.map((item,index)=>({json:{url:urls[index].json.url,httpStatus:Number(item.json.statusCode||200),body:String(item.json.body||'').slice(0,750000),fetchedAt:new Date().toISOString()}}));"},
      "id": "official-normalize", "name": "Build snapshots", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [0,0]
    },
    {
      "parameters": {"method":"POST","url":"http://127.0.0.1:4320/v1/official-sources/snapshot","authentication":"genericCredentialType","genericAuthType":"httpBearerAuth","sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify($json) }}","options":{"timeout":120000}},
      "id": "official-store", "name": "Compare and store snapshot", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [240,0],
      "credentials": {"httpBearerAuth":{"id":"socialApiBearer01","name":"Finkavo Social API"}}
    }
  ],
  "connections": {
    "Every 3 hours":{"main":[[{"node":"Canonical URLs","type":"main","index":0}]]},
    "Canonical URLs":{"main":[[{"node":"Fetch canonical page","type":"main","index":0}]]},
    "Fetch canonical page":{"main":[[{"node":"Build snapshots","type":"main","index":0}]]},
    "Build snapshots":{"main":[[{"node":"Compare and store snapshot","type":"main","index":0}]]}
  },
  "settings":{"executionOrder":"v1","timezone":"Europe/Lisbon"},
  "active":false,
  "tags":[]
}
