      "typeVersion": 1,
      "position": [
        -500,
        0
      ]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:4320/v1/posts?status=draft",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b8ff6cb1-e8a4-4b1e-9349-cb48c6c9f572",
      "name": "Get latest draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const posts=($json.posts||[]).slice(0,5); if(!posts.length) throw new Error('No draft is waiting for review'); return posts.map(post=>({json:{postId:post.id,expiresInMinutes:180}}));"
      },
      "id": "1a1ca4ce-ebef-4dcc-a42e-69ed0ccca0b9",
      "name": "Require draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:4320/v1/posts/{{$json.postId}}/request-review",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({expiresInMinutes:$json.expiresInMinutes}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "57064223-6b86-4017-9035-7756b4207db0",
      "name": "Create secure review link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
