{
  "id": "vJNj3c0yEynFYGPy",
  "name": "WF-05 Request Revision-bound Review",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "10-55/5 8 * * *"
            }
          ]
        }
      },
      "id": "94f53367-e98b-45d9-a16d-c47478ddcbb9",
      "name": "Every 5 minutes from 08:10 to 08:55",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -500,
        0
      ]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:4320/v1/posts?status=draft&plannedFor=today",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "timeout": 180000
        }
      },
      "id": "b8ff6cb1-e8a4-4b1e-9349-cb48c6c9f572",
      "name": "Get latest draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        0
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "socialApiBearer01",
          "name": "Finkavo Social API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const posts=($json.posts||[]).slice(0,5); if(!posts.length)return [{json:{hasDraft:false,message:'No draft is awaiting review.'}}]; return posts.map(post=>({json:{hasDraft:true,postId:post.id,expiresInMinutes:180}}));"
      },
      "id": "1a1ca4ce-ebef-4dcc-a42e-69ed0ccca0b9",
      "name": "Require draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c81742ea-d5f1-4e72-a379-f3003fd04a41",
              "leftValue": "={{ $json.hasDraft }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ff3dd955-d729-47ea-92d8-215974967af3",
      "name": "Draft available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:4320/v1/posts/{{$json.postId}}/request-review",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({expiresInMinutes:$json.expiresInMinutes}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "57064223-6b86-4017-9035-7756b4207db0",
      "name": "Create secure review link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        -100
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "socialApiBearer01",
          "name": "Finkavo Social API"
        }
      }
    },
    {
      "parameters": {},
      "id": "dd85a5f9-139b-4293-aac9-5ec7619f5df3",
      "name": "No draft awaiting review",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        440,
        120
      ]
    }
  ],
  "connections": {
    "Every 5 minutes from 08:10 to 08:55": {
      "main": [
        [
          {
            "node": "Get latest draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get latest draft": {
      "main": [
        [
          {
            "node": "Require draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Require draft": {
      "main": [
        [
          {
            "node": "Draft available?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Draft available?": {
      "main": [
        [
          {
            "node": "Create secure review link",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No draft awaiting review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "active": false,
  "tags": []
}
